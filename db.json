  "instruction_steps": [
    {
      "id": "1",
      "recipe_id": "1",
      "step_number": 1,
      "instruction_text": "Sauté the shallots and mushrooms in olive oil over medium heat until softened."
    },
    {
      "id": "2",
      "recipe_id": "1",
      "step_number": 2,
      "instruction_text": "Add the arborio rice and toast slightly, stirring constantly for about 1 minute."
    },
    {
      "id": "3",
      "recipe_id": "1",
      "step_number": 3,
      "instruction_text": "Gradually add the warm vegetable broth, one ladle at a time, stirring until absorbed. Continue this process for <span class='highlight' data-time='20' onclick='startTimer(20)'>20 minutes</span> or until the rice is al dente."
    },
    {
      "id": "4",
      "recipe_id": "1",
      "step_number": 4,
      "instruction_text": "Stir in the heavy cream and grated Parmesan cheese until completely creamy. Season with salt, pepper, and fresh thyme."
    },
    {
      "id": "5",
      "recipe_id": "1",
      "step_number": 5,
      "instruction_text": "Remove from heat and let sit for <span class='highlight' data-time='5' onclick='startTimer(5)'>5 minutes</span> to cool. Serve hot, garnished with extra herbs."
